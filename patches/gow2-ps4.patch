diff --git a/ps4/gow2_ps4_achievements.cpp b/ps4/gow2_ps4_achievements.cpp
new file mode 100644
index 0000000..008d024
--- /dev/null
+++ b/ps4/gow2_ps4_achievements.cpp
@@ -0,0 +1,92 @@
+// gow2-ps4 - the game's own Xbox 360 achievements, kept on the console and shown the port's way, as in MP3-PS4
+// (v00.06). MP3-PS4's mp3_ps4_achievements.cpp.
+//
+// The SDK does the bookkeeping: the game's achievement write (XGIUserWriteAchievements) reaches
+// KernelState::UnlockAchievement, whose AchievementManager holds the catalog read from the executable's XDBF resource
+// (names, descriptions, gamerscore, flags) and saves the unlocks to <user data>/achievements/<title>.toml. Here: a
+// notification listener that hands each new unlock to the quick menu's pop-up (gow2_ps4_menu.cpp), the SDK's own
+// notification turned off (logros_aviso_en_pantalla) so there is one, and the list the menu's ACHIEVEMENTS tab shows.
+// Every unlock is logged ("[achievements] unlocked"), and the catalog's size at start.
+
+#include "gow2_ps4_achievements.h"
+
+#include "gow2_ps4_menu.h"
+
+#include <ctime>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/achievement_manager.h>
+#include <rex/system/kernel_state.h>
+
+REXCVAR_DEFINE_BOOL(gow2_achievement_popups, true, "Gow2",
+                    "A pop-up when the game unlocks one of its achievements (the quick menu's style). Live");
+
+namespace gow2::achievements {
+namespace {
+
+rex::system::KernelState* g_kernel = nullptr;
+bool g_listening = false;
+
+// XDBF achievement flags: shown in the list before it is earned.
+constexpr uint32_t kShowUnachieved = 0x8;
+
+}  // namespace
+
+void Install(rex::Runtime& runtime) {
+  g_kernel = runtime.kernel_state();
+  if (!g_kernel || g_listening) return;
+  g_listening = true;
+  rex::cvar::SetFlagByName("logros_aviso_en_pantalla", "false");  // the menu's pop-up instead
+  auto& manager = g_kernel->achievements();
+  manager.RegisterNotificationCallback([](const rex::system::AchievementEvent& event) {
+    REXLOG_INFO("[achievements] unlocked {:08X} \"{}\" ({} G)", event.achievement.id, event.achievement.label,
+                event.achievement.gamerscore);
+    if (REXCVAR_GET(gow2_achievement_popups))
+      gow2::menu::ShowAchievement(event.achievement.label, event.achievement.gamerscore);
+  });
+  const auto list = List();
+  uint32_t unlocked = 0, score = 0, total = 0;
+  for (const Entry& e : list) {
+    total += e.gamerscore;
+    if (e.unlocked) {
+      ++unlocked;
+      score += e.gamerscore;
+    }
+  }
+  REXLOG_INFO("[achievements] {} in the game's catalog, {} unlocked ({} of {} G)", list.size(), unlocked, score,
+              total);
+}
+
+std::vector<Entry> List() {
+  std::vector<Entry> out;
+  if (!g_kernel) return out;
+  const auto& manager = g_kernel->achievements();
+  for (const auto& info : manager.ListAchievements()) {
+    Entry e;
+    e.id = info.id;
+    e.name = info.label;
+    e.description = info.description;
+    e.locked_description = info.unachieved_description;
+    e.gamerscore = info.gamerscore;
+    e.secret = !(info.flags & kShowUnachieved);
+    e.unlocked = manager.IsUnlocked(info.id);
+    e.filetime = e.unlocked ? manager.GetUnlockTime(info.id) : 0;
+    out.push_back(std::move(e));
+  }
+  return out;
+}
+
+std::string DateText(uint64_t filetime) {
+  if (!filetime) return "";
+  const int64_t unix_seconds = int64_t(filetime / 10000000ull) - 11644473600ll;
+  const std::time_t t = std::time_t(unix_seconds);
+  std::tm tm{};
+  gmtime_r(&t, &tm);
+  char text[16];
+  std::strftime(text, sizeof(text), "%Y-%m-%d", &tm);
+  return text;
+}
+
+}  // namespace gow2::achievements
diff --git a/ps4/gow2_ps4_achievements.h b/ps4/gow2_ps4_achievements.h
new file mode 100644
index 0000000..e58084f
--- /dev/null
+++ b/ps4/gow2_ps4_achievements.h
@@ -0,0 +1,36 @@
+// gow2-ps4 - the game's achievements, in the quick menu and as pop-ups (gow2_ps4_achievements.cpp).
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex {
+class Runtime;
+}
+
+namespace gow2::achievements {
+
+struct Entry {
+  uint32_t id = 0;
+  std::string name;
+  std::string description;         // what it was for (shown once unlocked)
+  std::string locked_description;  // what to do (shown while locked; may be empty)
+  uint32_t gamerscore = 0;
+  bool secret = false;             // not shown while locked (the game's "show unachieved" flag clear)
+  bool unlocked = false;
+  uint64_t filetime = 0;           // when (Windows FILETIME, UTC)
+};
+
+// OnPreLaunchModule: listens to the SDK's achievement manager (its catalog comes from the game's own data, its unlocks
+// are saved under the user data folder) and turns the SDK's own notification off for the menu's pop-up.
+void Install(rex::Runtime& runtime);
+
+// The game's achievements in its order, with their unlock state (any thread).
+std::vector<Entry> List();
+
+// "2026-11-24" for an unlock time.
+std::string DateText(uint64_t filetime);
+
+}  // namespace gow2::achievements
diff --git a/ps4/gow2_ps4_app.h b/ps4/gow2_ps4_app.h
new file mode 100644
index 0000000..09312af
--- /dev/null
+++ b/ps4/gow2_ps4_app.h
@@ -0,0 +1,106 @@
+// gow2-ps4 - Gears of War 2 (Xbox 360, retail disc) on the PS4: the app.
+//
+// The game's files (the extracted disc: default.xex, GearGame/CookedXenon ...) are read from game/ inside the package
+// (/app0/game, the one-file package scripts/build-gow2.sh pkg makes with GOW2_PKG_GAME=1), else from
+// /data/GOW2/game. /data/GOW2 is the app's folder (the SDK's executable and user folder on the PS4): the settings
+// file gow2.toml, the logs, the saves (the content root), the freeze report.
+//
+// What differs from the PC port (santiquiroz/gears-of-war-2-pc-port): the GPU is the SDK's Xenos emulation on its
+// Vulkan back end on ps4-kit's RADV (not D3D12), sound through sceAudioOut, the pad through scePad (the SDK's PS4 back
+// ends); no window, no keyboard or mouse, no PC Options menu (the L3+R3 quick menu instead), no System Link yet.
+
+#pragma once
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/rex_app.h>
+#include <rex/runtime.h>
+#include <rex/system.h>
+
+#include <cstdlib>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <system_error>
+
+#include <ps4_kit.h>
+
+#include "gow2_ps4.h"
+#include "gow2_ps4_menu.h"
+
+class Gow2App : public rex::ReXApp {
+ public:
+  using rex::ReXApp::ReXApp;
+
+  static std::unique_ptr<rex::ui::WindowedApp> Create(rex::ui::WindowedAppContext& ctx) {
+    return std::unique_ptr<Gow2App>(new Gow2App(ctx, "gow2", PPCImageConfig));
+  }
+
+ protected:
+  // The SDK's Xenos GPU (Vulkan back end), linked into the eboot, and the port's defaults for SDK settings (each only
+  // while the setting still has the SDK's value, so gow2.toml wins).
+  void OnPreSetup(rex::RuntimeConfig& config) override {
+    if (config.gpu_plugin.empty()) config.gpu_plugin = "xenos";
+    gow2::ps4::ApplyDefaults();
+  }
+
+  // game_data_root is the folder with default.xex (ConstructRuntime checks it).
+  void OnConfigurePaths(rex::PathConfig& paths) override {
+    if (!paths.game_data_root.empty()) return;
+    const std::string flag = REXCVAR_GET(gow2_game);
+    if (!flag.empty()) {
+      paths.game_data_root = flag;
+      return;
+    }
+    if (const auto packaged = PackagedFolder("game", "default.xex"); !packaged.empty()) {
+      paths.game_data_root = packaged;
+      return;
+    }
+    paths.game_data_root = rex::filesystem::GetExecutableFolder() / "game";
+  }
+
+  void OnPostInitLogging() override { gow2::ps4::LogSystem(); }
+
+  // The L3+R3 quick menu and the frame counter (gow2_ps4_menu.cpp); its settings go to the file ReXApp loads
+  // (/data/GOW2/gow2.toml).
+  void OnConfigureFonts(ImFontAtlas* atlas) override { gow2::menu::AddFonts(atlas); }
+  void OnCreateDialogs(rex::ui::ImGuiDrawer* drawer) override {
+    gow2::menu::Attach(app_context(), drawer, rex::filesystem::GetExecutableFolder() / "gow2.toml");
+  }
+
+  void OnLoadXexImage(std::string& xex_image) override {
+    std::error_code ec;
+    const auto root = game_data_root();
+    if (!std::filesystem::is_regular_file(root / "default.xex", ec)) {
+      Fail("Gears of War 2: default.xex is missing from " + root.string() +
+           ". Install the package that holds the game, or copy your extracted disc (default.xex and GearGame/) to "
+           "/data/GOW2/game.");
+    }
+    // The recompiled code is the retail executable's without a title update (the PC port's hints and fixes are for
+    // its addresses); a title update's default.xexp next to it would be applied over it by the loader.
+    if (std::filesystem::exists(root / "default.xexp", ec)) {
+      Fail("Gears of War 2: " + (root / "default.xexp").string() +
+           " is a title update; this port is built from the disc's executable without one. Remove the file.");
+    }
+    REXLOG_INFO("gow2: game at {}; loading {}", root.string(), xex_image);
+  }
+
+  void OnPreLaunchModule() override { gow2::ps4::Install(*runtime()); }
+
+ private:
+  // name/ inside the package when it holds marker: before any copy in /data/GOW2.
+  static std::filesystem::path PackagedFolder(const char* name, const char* marker) {
+    std::error_code ec;
+    const std::filesystem::path folder = std::filesystem::path("/app0") / name;
+    if (std::filesystem::is_regular_file(folder / marker, ec)) return folder;
+    return {};
+  }
+
+  [[noreturn]] static void Fail(const std::string& msg) {
+    REXLOG_ERROR("{}", msg);
+    rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, msg);
+    rex::FlushLogging();
+    std::_Exit(1);
+  }
+};
diff --git a/ps4/gow2_ps4_game.cpp b/ps4/gow2_ps4_game.cpp
new file mode 100644
index 0000000..d9380df
--- /dev/null
+++ b/ps4/gow2_ps4_game.cpp
@@ -0,0 +1,115 @@
+// gow2-ps4 - the game's own code: xenia-canary's game patches for this executable as settings.
+//
+// The PC port's tools/patch_game_patches.py (gears-of-war-2-pc-port, BSD-3-Clause; adapted there from
+// gears-judgement-recomp) rewrites 23 sites of the generated C++ so each patch asks Gow2GamePatch(id) whether it is on;
+// this file answers from the port's settings (saved in /data/GOW2/gow2.toml, most of them in the quick menu's GAME
+// tab). Addresses are the retail executable's (title 4D53082D, Media ID 63AF211E, 0.0.0.5; module hash
+// BDB97753374D520A):
+//
+//   id 1  Black Shading Fix      0x82806A44 stw r11,11940(r6) -> li r11,0: GUseTilingMode = FALSE. No predicated
+//                                tiling: the scene is drawn once without MSAA instead of once per EDRAM tile
+//   id 2  Texture Streaming Fix  0x8280D534 (pool size 196) and 0x8280DDC8 (RHIGetTextureMemoryStats returns 0)
+//   id 3  16x anisotropic filtering, 0x8280E7FC
+//   id 4  Frame rate unlock      0x824A2E94 (the frame limiter's load skipped) and 0x8298CFB0 (present interval 1)
+//   id 5  AO upscaling fix       0x8272E00C, 0x8272FF54, 0x8272B1F8, 0x8252D608
+//   id 6  DoF upscaling fix      0x827296BC, 0x82729700
+//   id 7  Widescreen width (0 = the game's own 16:9), with 0x82634F44 and five more FOV sites
+//   id 8  The back buffer height the game builds its surfaces with (0x82806B10 li r11,720: always replaced)
+//   id 9  The height the widescreen aspect is taken from
+
+#include "gow2_pch.h"
+#include "gow2_init.h"
+
+#include <cstdint>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DECLARE(int32_t, gow2_antialiasing);  // gow2_ps4.cpp: 2 = the original MSAA in predicated tiles
+
+REXCVAR_DEFINE_BOOL(gow2_texture_streaming_fix, true, "Gow2",
+                    "Texture Streaming Fix: texture pool size 196 and RHIGetTextureMemoryStats = FALSE (the "
+                    "streaming fudge factor stays 1.0), less texture pop-in in heavy scenes. Restart");
+REXCVAR_DEFINE_BOOL(gow2_aniso16, true, "Gow2", "16x anisotropic filtering on the game's textures. Restart");
+// v00.03: on by default: the engine's own 30 fps limiter is what held light scenes
+// at 30 (v00.02: 30.0 fps with the GPU emulation waiting for the vblank 45-84 % of the time).
+REXCVAR_DEFINE_BOOL(gow2_unlock_fps, true, "Gow2",
+                    "Frame rate unlock: the engine's 30 fps limiter is skipped and the game presents every vblank "
+                    "(up to 60; the game's speed follows the frame time)");
+// v00.03: Unreal's depth pre-pass. Before the colour pass the scene renderer draws every opaque occluder once more
+// into the depth buffer only (FDepthDrawingPolicyFactory: static meshes in the depth draw lists, dynamic ones
+// through TDynamicPrimitiveDrawer<FDepthDrawingPolicyFactory>). v00.02's census of a heavy fight: 533 of 1,936
+// draws a frame were these (27 %), each one costing the game's render thread - the limit in heavy scenes, 97 % busy
+// - and the GPU emulation their full price, to save pixel work the PS4's GPU has to spare. The colour pass tests and
+// writes depth itself, so without it the picture is the same (gears2-nx skips it too: "same image, less GPU").
+REXCVAR_DEFINE_BOOL(gow2_depth_prepass, false, "Gow2",
+                    "Unreal's depth pre-pass (every opaque object drawn once more, depth only, before the colour "
+                    "pass). false: left out - a quarter fewer draws in busy scenes, the same picture. Restart");
+REXCVAR_DEFINE_BOOL(gow2_ao_upscaling_fix, true, "Gow2",
+                    "Ambient occlusion fix (xenia-canary's AO Upscaling Fix): the AO working size from the back "
+                    "buffer, AO flags forced, one AO occluder helper off. Restart");
+REXCVAR_DEFINE_BOOL(gow2_dof_upscaling_fix, true, "Gow2",
+                    "Depth of field fix (xenia-canary's DoF Upscaling Fix): no gaussian blur factor in the DoF "
+                    "sampling, less blur ghosting. Restart");
+
+extern "C" int Gow2GamePatch(int id) {
+  switch (id) {
+    case 1: return REXCVAR_GET(gow2_antialiasing) != 2;  // no tiling unless the original MSAA was asked for
+    case 2: return REXCVAR_GET(gow2_texture_streaming_fix);
+    case 3: return REXCVAR_GET(gow2_aniso16);
+    case 4: return REXCVAR_GET(gow2_unlock_fps);
+    case 5: return REXCVAR_GET(gow2_ao_upscaling_fix);
+    case 6: return REXCVAR_GET(gow2_dof_upscaling_fix);
+    case 7: return 0;    // the game's own 16:9 picture (the PS4 output is 1280x720 or scaled from it)
+    case 8: return 720;  // the back buffer height (the original li r11,720)
+    case 9: return 720;
+    default: return 0;
+  }
+}
+
+// Called only while Gow2GamePatch(7) gives a width (never here): the FOV stays the game's.
+extern "C" double Gow2WidescreenHalfFov(double half_fov, int /*site*/) {
+  return half_fov;
+}
+
+// ============================================================================
+// The depth pre-pass (v00.03, gow2_depth_prepass)
+// ============================================================================
+// Found from the depth-only shader types (tools/xrefs.py over the image): the static initializers of
+// TDepthOnlyVertexShader<0> / <1> and FDepthOnlyPixelShader (0x82F338F8, 0x82F33850, 0x82F339A0) register the types
+// at 0x8314B3C0, 0x8314B468 and 0x8313C284; the drawing policies that fetch those shaders are FDepthDrawingPolicy's
+// constructor (sub_826FCA70: <0> + the pixel shader for masked materials) and FPositionOnlyDepthDrawingPolicy's
+// (sub_826FCDF0: <1>). Both are built in exactly two places:
+//   sub_826FD078  FDepthDrawingPolicyFactory::AddStaticMesh - called only from FStaticMesh::AddToDrawLists
+//                 (sub_82727AE0, which hands a static mesh to six draw list factories): puts the mesh in the scene's
+//                 PositionOnlyDepthDrawList / DepthDrawList (calls the two lists' AddMesh, sub_82717548/sub_827177C0)
+//   sub_826FD1F0  FDepthDrawingPolicyFactory::DrawDynamicMesh - called only from sub_8273CF28, the
+//                 TDynamicPrimitiveDrawer<FDepthDrawingPolicyFactory> the pre-pass draws dynamic occluders with;
+//                 returns TRUE when it drew
+// With the pre-pass off the static depth lists stay empty and the dynamic drawer draws nothing, so the pre-pass costs
+// the render thread a walk over empty lists. Read once: the static lists are filled as the level's meshes attach.
+namespace {
+bool DepthPrepassOn() {
+  static const bool on = [] {
+    const bool v = REXCVAR_GET(gow2_depth_prepass);
+    REXLOG_INFO("[gpu] Unreal's depth pre-pass: {}", v ? "on (the original)" : "left out (the colour pass writes depth)");
+    return v;
+  }();
+  return on;
+}
+}  // namespace
+
+REX_EXTERN(sub_826FD078) {  // FDepthDrawingPolicyFactory::AddStaticMesh
+  if (!DepthPrepassOn()) {
+    return;
+  }
+  __imp__sub_826FD078(ctx, base);
+}
+
+REX_EXTERN(sub_826FD1F0) {  // FDepthDrawingPolicyFactory::DrawDynamicMesh -> UBOOL drew
+  if (!DepthPrepassOn()) {
+    ctx.r3.u64 = 0;
+    return;
+  }
+  __imp__sub_826FD1F0(ctx, base);
+}
