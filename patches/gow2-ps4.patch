+                    "gow2_auto_profile_s seconds, record an 8 s CPU profile of every thread (/data/GOW2/profiles)");
+REXCVAR_DEFINE_INT32(gow2_auto_profile_fps, 32, "Gow2", "Diagnostic, gow2_auto_profile: under this many frames a second")
+    .range(1, 60);
+REXCVAR_DEFINE_INT32(gow2_auto_profile_s, 10, "Gow2", "Diagnostic, gow2_auto_profile: for this many seconds in a row")
+    .range(1, 600);
