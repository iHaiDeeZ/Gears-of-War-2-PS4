diff --git a/ps4/CMakeLists.txt b/ps4/CMakeLists.txt
new file mode 100644
index 0000000..ecf23e4
--- /dev/null
+++ b/ps4/CMakeLists.txt
@@ -0,0 +1,127 @@
+# gow2-ps4 - Gears of War 2 (Xbox 360 retail disc, 4D53082D) on the PS4 (ps4-kit: clang 21, OpenOrbis, x86-64 Jaguar).
+#
+# The Vigilante 8 / MP3 / MGR ports' way (iHaiDeeZ/Vigilante-8-Arcade-PS4, iHaiDeeZ/MP3-PS4, iHaiDeeZ/MGR-PS4) on
+# the Gears of War 2 PC port (santiquiroz/gears-of-war-2-pc-port, BSD-3-Clause: its codegen manifest, hints and
+# generated-code fixes): the game's PowerPC code recompiled to C++ by ReXGlue v0.10.0's code generator and built for
+# x86-64, the runtime being the V8 port's PS4 SDK (rexglue-sdk-nx + MP3's PS4 layer), the game's command ring drawn by
+# the SDK's own Xenos emulation on its Vulkan back end, on ps4-kit's statically linked RADV. One eboot.
+#
+# Configure (the port's scripts/build-gow2.sh app does it):
+#   ps4_cmake -S ps4 -B <build> -G Ninja -DCMAKE_BUILD_TYPE=Release \
+#     -DCMAKE_PROJECT_gow2_INCLUDE=$PS4_KIT/ps4-kit.cmake -DPS4_KIT_NETFS=OFF \
+#     -DREXSDK_DIR=<the PS4 SDK> -DGOW2_CODEGEN_DIR=<codegen output> -DREXGLUE_PLATFORM_PS4=ON -DREXGLUE_USE_VULKAN=ON
+
+cmake_minimum_required(VERSION 3.25)
+project(gow2 LANGUAGES C CXX)
+
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+if(NOT REXGLUE_PLATFORM_PS4)
+    message(FATAL_ERROR "ps4: the PS4 build (-DREXGLUE_PLATFORM_PS4=ON, ps4-kit's toolchain)")
+endif()
+
+get_filename_component(GOW2_DIR "${CMAKE_CURRENT_SOURCE_DIR}" ABSOLUTE)
+
+set(GOW2_CODEGEN_DIR "" CACHE PATH "The codegen's output folder (holds generated/default/)")
+set(GOW2_GENERATED "${GOW2_CODEGEN_DIR}/generated/default")
+if(NOT EXISTS "${GOW2_GENERATED}/sources.cmake")
+    message(FATAL_ERROR
+        "GOW2_CODEGEN_DIR must point at the codegen's output "
+        "(no generated/default/sources.cmake under '${GOW2_CODEGEN_DIR}')")
+endif()
+
+set(REXSDK_DIR "" CACHE PATH "Path to the PS4 SDK (rexglue-sdk-nx + the PS4 layer)")
+if(NOT REXSDK_DIR)
+    message(FATAL_ERROR "REXSDK_DIR: the PS4 SDK's source tree")
+endif()
+add_subdirectory("${REXSDK_DIR}" rexglue-sdk)
+message(STATUS "gow2: ReXGlue SDK from ${REXSDK_DIR}")
+
+# The mirror of the generated tree with the PS4 PCH (tools/make_ps4_pch.py).
+find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
+set(GOW2_TREE "${CMAKE_BINARY_DIR}/generated_ps4")
+execute_process(
+    COMMAND "${Python3_EXECUTABLE}" -I "${GOW2_DIR}/tools/prepare_tree.py"
+            "${GOW2_GENERATED}" "${GOW2_TREE}" "${GOW2_DIR}/tools/make_ps4_pch.py" gow2_pch.h
+    RESULT_VARIABLE _gow2_tree_rc)
+if(NOT _gow2_tree_rc EQUAL 0)
+    message(FATAL_ERROR "gow2: tools/prepare_tree.py failed (${_gow2_tree_rc})")
+endif()
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    "${GOW2_GENERATED}/gow2_pch.h"
+    "${GOW2_GENERATED}/sources.cmake"
+    "${GOW2_DIR}/tools/make_ps4_pch.py"
+    "${GOW2_DIR}/tools/prepare_tree.py")
+
+# generated/default/sources.cmake: the support units and the recompiled ones. CMAKE_CURRENT_LIST_DIR there is the mirror.
+include("${GOW2_TREE}/sources.cmake")
+set(GOW2_GUEST_SOURCES ${GENERATED_SOURCES})
+# No debug info for the generated units, the guest's floating point unfused (the Jaguar has no FMA unit), no strict
+# aliasing (guest memory is read through any type), a section per function (for a later hot-function order), as
+# MP3's port builds its generated code.
+set(GOW2_RECOMP_OPTIONS -g0 -ffp-contract=off -fno-strict-aliasing -ffunction-sections)
+# The registration unit is one long function of SetFunction calls, run once at startup: -O1 and no PCH.
+set_source_files_properties("${GOW2_TREE}/gow2_register.cpp" PROPERTIES
+    COMPILE_OPTIONS "-O1"
+    SKIP_PRECOMPILE_HEADERS ON)
+list(LENGTH GOW2_GUEST_SOURCES _gow2_n)
+message(STATUS "gow2: ${_gow2_n} recompiled sources from ${GOW2_GENERATED}")
+
+add_executable(gow2
+    main_ps4.cpp
+    gow2_ps4.cpp
+    gow2_ps4_game.cpp
+    gow2_ps4_native.cpp
+    gow2_ps4_menu.cpp
+    gow2_ps4_achievements.cpp
+)
+# gow2_ps4_native.cpp decodes the game's LZX blocks with the SDK's libmspack (its thirdparty target).
+target_link_libraries(gow2 PRIVATE mspack)
+
+add_library(gow2_recomp OBJECT ${GOW2_GUEST_SOURCES})
+target_include_directories(gow2_recomp PRIVATE "${GOW2_TREE}")
+target_link_libraries(gow2_recomp PRIVATE rex::runtime)
+rexglue_apply_target_settings(gow2_recomp)
+target_precompile_headers(gow2_recomp PRIVATE "${GOW2_TREE}/gow2_pch.h")
+target_compile_options(gow2_recomp PRIVATE ${GOW2_RECOMP_OPTIONS})
+target_link_libraries(gow2 PRIVATE gow2_recomp)
+target_include_directories(gow2 PRIVATE "${GOW2_TREE}" "${CMAKE_CURRENT_SOURCE_DIR}")
+target_link_libraries(gow2 PRIVATE rex::runtime)
+target_compile_options(gow2 PRIVATE -ffp-contract=off -fno-strict-aliasing)
+
+# The version and the commit it was built from, in the first lines of the log.
+set(GOW2_VERSION "00.00" CACHE STRING "Version in the log")
+execute_process(COMMAND git rev-parse --short=10 HEAD WORKING_DIRECTORY "${GOW2_DIR}"
+                OUTPUT_VARIABLE GOW2_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
+if(NOT GOW2_COMMIT)
+    set(GOW2_COMMIT "unknown")
+endif()
+set_property(SOURCE ${CMAKE_CURRENT_SOURCE_DIR}/gow2_ps4.cpp ${CMAKE_CURRENT_SOURCE_DIR}/gow2_ps4_menu.cpp APPEND
+             PROPERTY COMPILE_DEFINITIONS GOW2_VERSION="${GOW2_VERSION}" GOW2_COMMIT="${GOW2_COMMIT}")
+# The quick menu's Lato fonts are #embed'ed (fonts/, SIL Open Font License: fonts/LICENSE-Lato.txt; MP3-PS4's).
+set_property(SOURCE ${CMAKE_CURRENT_SOURCE_DIR}/gow2_ps4_menu.cpp APPEND PROPERTY OBJECT_DEPENDS
+             ${CMAKE_CURRENT_SOURCE_DIR}/fonts/Lato-Regular.ttf ${CMAKE_CURRENT_SOURCE_DIR}/fonts/Lato-Black.ttf)
+
+# The runtime, ReXApp and the PS4 entry point, with the Xenos GPU (Vulkan) linked whole; RADV and the kit's WSI; the
+# eboot.
+rexglue_configure_target(gow2 GPU_PLUGINS xenos)
+ps4_kit_link_mesa(gow2)
+ps4_kit_app(gow2)
+# The kit's DNS wrap (ps4_net.cpp) without its SMB/NFS shares (PS4_KIT_NETFS off): the libc member has to be pulled in
+# by name, or __real_getaddrinfo stays an import create-fself refuses (ConkerLR's, MGR's and MP3's fix).
+target_link_options(gow2 PRIVATE --undefined=getaddrinfo)
+# The same for malloc_usable_size, which the kit wraps too (ps4-kit.cmake PS4_KIT_WRAPS): nothing in this eboot pulls
+# libc's member in otherwise (the V8 port's v00.01 link: "missing module for symbol (malloc_usable_size)").
+target_link_options(gow2 PRIVATE --undefined=malloc_usable_size)
+
+# v00.05: the hot functions together at the start of .text (tools/make_order.py from burst profiles of busy places:
+# order/hot-order.txt, link names). The eboot's text is ~50 MB and a busy frame ran code from all over it; the
+# sampled functions are ~8 MB, hottest first. ld.lld links the eboot itself (no -Wl,).
+option(GOW2_HOT_ORDER "Link the profiled hot functions together (order/hot-order.txt)" ON)
+set(GOW2_HOT_ORDER_FILE "${CMAKE_CURRENT_SOURCE_DIR}/order/hot-order.txt")
+if(GOW2_HOT_ORDER AND EXISTS "${GOW2_HOT_ORDER_FILE}")
+    target_link_options(gow2 PRIVATE "--symbol-ordering-file=${GOW2_HOT_ORDER_FILE}" --no-warn-symbol-ordering)
+    set_property(TARGET gow2 APPEND PROPERTY LINK_DEPENDS "${GOW2_HOT_ORDER_FILE}")
+    message(STATUS "gow2: hot-function link order from ${GOW2_HOT_ORDER_FILE}")
+endif()
diff --git a/ps4/gow2_ps4.cpp b/ps4/gow2_ps4.cpp
new file mode 100644
index 0000000..9f5d157
--- /dev/null
+++ b/ps4/gow2_ps4.cpp
@@ -0,0 +1,392 @@
+// gow2-ps4 - Gears of War 2 on the PS4: the port's settings for ps4-kit's runtime and the SDK, and its diagnostics.
+//
+// /data/GOW2 is the app's folder: gow2.toml (written on the first start), the logs, the saves, the kit's boot trace
+// and crash log, hang.log (the freeze report). The SDK's executable and user folders point here
+// (sdk/src/core/filesystem_posix.cpp), because /app0 is read-only.
+
+#include "gow2_pch.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <thread>
+
+#include <ps4_kit.h>
+#include <ps4_kit_diag.h>
+#include <ps4_vk_wsi.h>
+
+#include <cstring>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xboxkrnl/video.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/xmemory.h>
+
+#include "gow2_ps4.h"
+#include "gow2_ps4_achievements.h"
+#include "gow2_ps4_menu.h"
+
+#include <rex/kernel/xam/ui_hooks.h>
+
+PS4_DIAG_DATA_DIR("/data/GOW2");
+
+// The main heap from direct memory (the V8 port's v00.11). By default it takes 256 MiB of the system flexible pool,
+// which the kernel's pthread objects (every std::mutex and condition variable: each guest event, semaphore and
+// thread has some), the system libc heap and Sony's modules share; V8 ran out of it 20 minutes into a race ("mutex
+// lock failed: Out of memory"). Direct memory has room after the guest arena.
+extern "C" void ps4_kit_configure_heap(ps4_kit_heap_options* options) {
+  options->log_tag = "gow2";
+  options->source_order = PS4_KIT_HEAP_DIRECT_FIRST;
+}
+
+// libkernel: the flexible memory still free (the kit's start line "heap: flexible memory available").
+extern "C" int32_t sceKernelAvailableFlexibleMemorySize(size_t* size);
+// The SDK (system/xobject.cpp, the V8 port's v00.11): live guest objects by type.
+extern "C" uint32_t rex_xobject_live_counts(uint32_t* out, uint32_t count);
+
+REXCVAR_DEFINE_STRING(gow2_game, "", "Gow2",
+                      "Game folder (the extracted disc: default.xex, GearGame/ ...). Empty: game/ in the package, "
+                      "then /data/GOW2/game");
+// The PC port's Android build turns them off too ("each occlusion query ends the render pass twice; off cut GPU work
+// 6-12 % with no visible change"); on the PS4 the SDK's Vulkan command processor also waits for the GPU at each one.
+REXCVAR_DEFINE_BOOL(gow2_occlusion_queries, false, "Gow2",
+                    "GPU occlusion queries answered by the GPU (the command processor waits for it at each one). "
+                    "false: every query reports its object visible");
+// The 3D scene's anti-aliasing. The original draws the scene with MSAA in predicated tiles (the D3D runtime replays
+// the scene once per EDRAM tile; the SDK reports whole-screen extents, so every scene draw would be translated once
+// per tile: the V8 port's v00.09 finding). xenia-canary's "Black Shading Fix" (GUseTilingMode = FALSE, the PC port's
+// game patch 1, gow2_ps4_game.cpp) makes the game draw it once without MSAA; FXAA on the picture instead.
+REXCVAR_DEFINE_INT32(gow2_antialiasing, 0, "Gow2",
+                     "The 3D scene's anti-aliasing: 0 = FXAA on the picture (no tiling: the scene drawn once), 1 = "
+                     "none (no tiling), 2 = the original MSAA in predicated tiles (every scene draw once per tile, "
+                     "far slower; the dynamic lighting artifacts the Black Shading Fix removes). 2 needs a restart");
+REXCVAR_DEFINE_BOOL(gow2_msr_global_lock, false, "Gow2",
+                    "The recompiled code's interrupts-off regions (mtmsrd) as one process-wide mutex, as the codegen "
+                    "makes them. false: per-thread state (the atomics inside are host compare-and-swaps already)");
+REXCVAR_DEFINE_BOOL(gow2_freeze_report, true, "Gow2",
+                    "Diagnostic: when the game shows no new frame for 15 s, the stacks of every thread to "
+                    "/data/GOW2/hang.log (again 30 s later)");
+REXCVAR_DEFINE_BOOL(gow2_frame_log, true, "Gow2", "A line in the log every 10 s with the game's frames per second");
+REXCVAR_DEFINE_BOOL(gow2_memory_log, true, "Gow2",
+                    "Diagnostic: a [memory] line in the log every 10 s - the free flexible memory (the pool the "
+                    "kernel's pthread objects come from), the heap, and the live guest objects by type");
+REXCVAR_DEFINE_STRING(gow2_radv_debug, "", "Gow2",
+                      "RADV_DEBUG for the GPU driver (RADV's comma-separated debug options; empty: none)");
+// v00.02: RADV's own shader cache (Mesa's disk cache, built into ps4-kit's Mesa) only runs with a folder in
+// MESA_SHADER_CACHE_DIR; without it every start compiled every pipeline from scratch (~20 ms each on the Jaguar),
+// including the ones the SDK re-creates at start from its pipeline storage.
+REXCVAR_DEFINE_BOOL(gow2_gpu_shader_cache, true, "Gow2",
+                    "Keep the GPU driver's compiled shaders in /data/GOW2/cache/mesa: the pipelines of earlier runs "
+                    "are made again in a moment instead of compiled again. Restart");
+// v00.03: the engine's own SystemSettings, written into the game's FSystemSettings object (GSystemSettings at guest
+// 0x8313751C; field offsets decompiled from its loader sub_82350278's key table, decomp/system_settings.tsv). Each
+// option leaves the game's value alone until it is changed. The engine reads these as it draws (shadows, LOD
+// biases) or as components attach (detail mode: what loads after the change).
+REXCVAR_DEFINE_INT32(gow2_detail_mode, -1, "Gow2",
+                     "Engine detail mode (SystemSettings DetailMode): -1 = the game's (2, high), 1 = medium, 0 = low "
+                     "(fewer decorative objects and decals: fewer draws). Applies to what loads afterwards")
+    .range(-1, 2);
+REXCVAR_DEFINE_INT32(gow2_character_lod, 0, "Gow2",
+                     "Character detail (SystemSettings SkeletalMeshLODBias): 0 = the game's, 1 / 2 = coarser meshes "
+                     "and fewer animated bones (less work on the game and render threads). Live")
+    .range(0, 2);
+REXCVAR_DEFINE_INT32(gow2_effects_lod, 0, "Gow2",
+                     "Effects detail (SystemSettings ParticleLODBias): 0 = the game's, 1 / 2 = coarser particle "
+                     "systems. Live")
+    .range(0, 2);
+REXCVAR_DEFINE_BOOL(gow2_dynamic_shadows, true, "Gow2",
+                    "Dynamic and character shadows (SystemSettings DynamicShadows, LightEnvironmentShadows). Live");
+// v00.05: the game's motion blur (SystemSettings MotionBlur, data +0x028 = 0x83137548: read by UMotionBlurEffect and
+// UUberPostProcessEffect). v00.06: off by default (the picture looked blurry whenever the camera moved).
+REXCVAR_DEFINE_BOOL(gow2_motion_blur, false, "Gow2",
+                    "The engine's motion blur (SystemSettings MotionBlur): the picture smeared along the camera's "
+                    "movement (roadie run, fast turns). Live");
+// v00.05: the SDK's presenter takes Vulkan's IMMEDIATE mode when it is there (vulkan_presenter.cpp: "allow tearing
+// to reduce latency"), which ps4-kit's WSI flips at the next scanline (ORBIS_VIDEO_OUT_FLIP_HSYNC). The guest's
+// vblanks come from the SDK's own 60 Hz timer, not the display's, so every frame tore at a drifting line: v00.04's clip
+// shows the cut across Marcus whenever the camera moved (worse with the unlocked frame rate: more frames, more cuts).
+REXCVAR_DEFINE_BOOL(gow2_vsync, true, "Gow2",
+                    "Flip each frame at the display's vblank (no tearing). false: as soon as it is drawn (the SDK's "
+                    "immediate mode: the picture tears where it moves). Live");
+REXCVAR_DEFINE_BOOL(gow2_gpu_trace, false, "Gow2",
+                    "Diagnostic: the GPU driver's flight recorder (RADV_PS4_TRACE): each submission's commands, "
+                    "the memory they point to, every shader's code and the last draw the GPU reached, in "
+                    "/data/Crema/gpu/flight (where the kit's RADV writes), which survive the app being killed by a "
+                    "GPU fault (it found the V8 port's tessellation factor ring crash); it costs speed");
+
+namespace gow2::ps4 {
+
+namespace {
+
+std::atomic<uint32_t> g_swaps{0};
+rex::memory::Memory* g_memory = nullptr;
+
+// v00.03: GSystemSettings (the engine's FSystemSettings object) and the fields the options above write.
+// v00.06: the fields are offsets into its FSystemSettingsData, which starts 4 bytes in: +0 is the object's vtable
+// pointer (only the two constructors sub_82358A58/sub_823598F0 store there; nothing reads it as data), and the loader's
+// key table (decomp/system_settings.tsv) gives offsets from the data. v00.03-v00.05 wrote 4 bytes low: "World detail"
+// into the vtable pointer, "Character detail" into OneFrameThreadLag, "Effects detail" into SkeletalMeshLODBias,
+// "Dynamic shadows" into MaxMultisamples + DynamicShadows, "Motion blur" into DirectionalLightmaps (the black
+// surfaces v00.05 showed: lightmapped meshes switched to lightmap shaders the level never loaded). Checked by who reads them
+// (tools/field_readers.py): 0x83137548 = MotionBlur is read by UMotionBlurEffect and UUberPostProcessEffect,
+// 0x83137520 = DetailMode by 11 functions, 0x83137544 = DirectionalLightmaps by 16 in the mesh drawing code.
+constexpr uint32_t kSystemSettings = 0x8313751C;
+constexpr uint32_t kSystemSettingsData = kSystemSettings + 4;
+constexpr uint32_t kDetailMode = 0x000, kMotionBlur = 0x028, kSkeletalMeshLODBias = 0x054, kParticleLODBias = 0x058,
+                   kDynamicShadows = 0x1BC, kLightEnvironmentShadows = 0x1C0;
+
+// One engine setting the port may override: the game's own value is read before the first write and put back when
+// the option returns to "the game's".
+struct EngineSetting {
+  uint32_t offset;
+  const char* name;
+  bool overridden = false;
+  uint32_t original = 0;
+  uint32_t written = 0;
+};
+EngineSetting g_settings[] = {
+    {kDetailMode, "DetailMode"},
+    {kSkeletalMeshLODBias, "SkeletalMeshLODBias"},
+    {kParticleLODBias, "ParticleLODBias"},
+    {kDynamicShadows, "DynamicShadows"},
+    {kLightEnvironmentShadows, "LightEnvironmentShadows"},
+    {kMotionBlur, "MotionBlur"},
+};
+
+uint32_t LoadBE(uint32_t guest) {
+  const uint8_t* p = g_memory->TranslateVirtual<const uint8_t*>(guest);
+  return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+}
+void StoreBE(uint32_t guest, uint32_t v) {
+  uint8_t* p = g_memory->TranslateVirtual<uint8_t*>(guest);
+  const uint32_t be = (v >> 24) | ((v >> 8) & 0xFF00) | ((v << 8) & 0xFF0000) | (v << 24);
+  std::memcpy(p, &be, 4);  // one aligned 32-bit store: the engine's reads see the old or the new value
+}
+
+// want < 0: the game's own value (put back if the port changed it). v00.07: the first write is always logged (it was
+// skipped when the game's value + 1 happened to be the option's value).
+void ApplySetting(EngineSetting& s, int64_t want) {
+  const uint32_t guest = kSystemSettingsData + s.offset;
+  if (want < 0) {
+    if (s.overridden) {
+      StoreBE(guest, s.original);
+      s.overridden = false;
+      REXLOG_INFO("[settings] {} back to the game's {}", s.name, s.original);
+    }
+    return;
+  }
+  bool first = false;
+  if (!s.overridden) {
+    s.original = LoadBE(guest);
+    s.overridden = true;
+    first = true;
+  }
+  if (first || s.written != uint32_t(want) || LoadBE(guest) != uint32_t(want)) {
+    StoreBE(guest, uint32_t(want));
+    if (first || s.written != uint32_t(want)) {
+      REXLOG_INFO("[settings] {} {} (the game's {})", s.name, want, s.original);
+    }
+    s.written = uint32_t(want);
+  }
+}
+
+// At each swap (the render thread; the engine's own settings code runs on the game thread and only at start or on a
+// "scale" console command).
+void ApplyEngineSettings() {
+  if (!g_memory) return;
+  ApplySetting(g_settings[0], REXCVAR_GET(gow2_detail_mode));
+  ApplySetting(g_settings[1], REXCVAR_GET(gow2_character_lod) > 0 ? REXCVAR_GET(gow2_character_lod) : -1);
+  ApplySetting(g_settings[2], REXCVAR_GET(gow2_effects_lod) > 0 ? REXCVAR_GET(gow2_effects_lod) : -1);
+  const int64_t shadows = REXCVAR_GET(gow2_dynamic_shadows) ? -1 : 0;
+  ApplySetting(g_settings[3], shadows);
+  ApplySetting(g_settings[4], shadows);
+  ApplySetting(g_settings[5], REXCVAR_GET(gow2_motion_blur) ? -1 : 0);
+}
+
+// v00.05: gow2_vsync into ps4-kit's WSI (an atomic it reads at each flip), at start and whenever the option changes.
+void ApplyVsync() {
+  static int applied = -1;
+  const int want = REXCVAR_GET(gow2_vsync) ? 1 : 0;
+  if (want == applied) return;
+  applied = want;
+  ps4kit::set_force_vsync(want != 0);
+  REXLOG_INFO("[gpu] frames flip {}", want ? "at the display's vblank (v-sync: no tearing)"
+                                           : "as soon as they are drawn (immediate: tearing)");
+}
+
+uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+// Each setting only while it still has the SDK's value: gow2.toml and the command line win.
+void SetDefault(const char* name, const char* value) {
+  if (!rex::cvar::HasNonDefaultValue(name)) rex::cvar::SetFlagByName(name, value);
+}
+
+// At each VdSwap, on the game's thread.
+void OnGuestSwap() {
+  gow2::menu::NoteSwap();  // the quick menu's frame counter and its L3+R3
+  const uint32_t n = g_swaps.fetch_add(1, std::memory_order_acq_rel) + 1;
+  // The engine settings (v00.03), from the 10th frame on: FSystemSettings::Initialize has read the ini by then.
+  if (n >= 10) ApplyEngineSettings();
+  ApplyVsync();
+  if (!REXCVAR_GET(gow2_frame_log)) return;
+  static uint64_t window_start = 0;
+  static uint32_t window_swaps = 0;
+  const uint64_t now = NowNs();
+  if (!window_start) {
+    window_start = now;
+    window_swaps = n;
+    REXLOG_INFO("[frames] first frame presented");
+    return;
+  }
+  if (now - window_start >= 10'000'000'000ull) {
+    const double seconds = double(now - window_start) / 1e9;
+    REXLOG_INFO("[frames] {:.1f} fps over the last {:.0f} s ({} frames so far)", double(n - window_swaps) / seconds,
+                seconds, n);
+    window_start = now;
+    window_swaps = n;
+  }
+}
+
+// Every 10 s (from the freeze watch's thread): the free flexible memory and its change since the start, the heap,
+// the live guest objects by type (the V8 port's v00.11 "Out of memory" crash would have shown coming here).
+void LogMemory() {
+  static size_t first_free = 0;
+  size_t free_bytes = 0;
+  sceKernelAvailableFlexibleMemorySize(&free_bytes);
+  if (!first_free) first_free = free_bytes;
+  char heap[192] = {};
+  ps4rt_heap_report(heap, sizeof(heap));
+  uint32_t live[16] = {};
+  const uint32_t total = rex_xobject_live_counts(live, 16);
+  // XObject::Type: 2 event, 3 file, 4 I/O completion, 6 mutant, 7 notify listener, 8 semaphore, 12 thread, 13 timer.
+  const uint32_t other = total - live[2] - live[3] - live[6] - live[7] - live[8] - live[12] - live[13];
+  REXLOG_INFO("[memory] flexible memory free {:.1f} MiB ({:+.1f} MiB since the start); {}; guest objects {}: events "
+              "{}, semaphores {}, mutants {}, timers {}, threads {}, files {}, notify listeners {}, other {}",
+              double(free_bytes) / 1048576.0, (double(free_bytes) - double(first_free)) / 1048576.0, heap, total,
+              live[2], live[8], live[6], live[13], live[12], live[3], live[7], other);
+}
+
+// When the game has shown no new frame for 15 s (after at least 60): every thread's stack (ps4-kit's thread dump: host
+// return addresses relative to .text, for llvm-symbolizer --obj=<the build's ELF in ~/gow2-build/oelf>; recompiled
+// guest functions are named sub_XXXXXXXX there) to /data/GOW2/hang.log, and once more 30 s later. MP3's freeze report.
+// Gears of War 2 loads its levels for a while with the loading screen still presenting, so a stall is a real one.
+void StartFreezeReport() {
+  std::thread([] {
+    ps4_watch_thread("gow2 freeze watch");
+    const std::string path = std::string(ps4_diag_data_dir()) + "/hang.log";
+    uint32_t last = g_swaps.load(std::memory_order_acquire);
+    auto last_change = std::chrono::steady_clock::now();
+    int dumps = 0;
+    int memory_ticks = 0;
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::seconds(1));
+      if (++memory_ticks >= 10) {
+        memory_ticks = 0;
+        if (REXCVAR_GET(gow2_memory_log)) LogMemory();
+      }
+      const uint32_t now_count = g_swaps.load(std::memory_order_acquire);
+      const auto now = std::chrono::steady_clock::now();
+      const double stalled = std::chrono::duration<double>(now - last_change).count();
+      if (now_count != last) {
+        if (dumps) REXLOG_WARN("[freeze] frames again after {:.0f} s ({} thread dumps in {})", stalled, dumps, path);
+        last = now_count;
+        last_change = now;
+        dumps = 0;
+        continue;
+      }
+      if (now_count < 60 || !REXCVAR_GET(gow2_freeze_report)) continue;
+      if ((dumps == 0 && stalled >= 15.0) || (dumps == 1 && stalled >= 45.0)) {
+        ++dumps;
+        const std::string reason = "gow2 freeze report " + std::to_string(dumps) + ": no new frame for " +
+                                   std::to_string(int(stalled)) + " s after " + std::to_string(now_count) + " frames";
+        REXLOG_WARN("[freeze] no new frame for {:.0f} s: the stacks of every thread to {}", stalled, path);
+        rex::FlushLogging();
+        ps4_dump_thread_stacks(path.c_str(), reason.c_str());
+        REXLOG_WARN("[freeze] thread dump {} written", dumps);
+        rex::FlushLogging();
+      }
+    }
+  }).detach();
+}
+
+}  // namespace
+
+void ApplyDefaults() {
+  // Textures whose fetch constants Xenia calls invalid (type bits 00) are real ones in the 360 games seen so far
+  // (MP3 v00.08's black world); Xenia binds them with this.
+  SetDefault("gpu_allow_invalid_fetch_constants", "true");
+  // Occlusion queries: the SDK's Vulkan command processor ends its submission and waits for the GPU at each one
+  // (MP3 v00.04: the command processor and the GPU took turns). Off unless gow2_occlusion_queries.
+  rex::cvar::SetFlagByName("occlusion_query_enable", REXCVAR_GET(gow2_occlusion_queries) ? "true" : "false");
+  // FXAA with gow2_antialiasing 0 (the SDK reads swap_post_effect as the graphics system starts; the quick menu
+  // changes it live through rex_gpu_set_swap_post_effect).
+  rex::cvar::SetFlagByName("swap_post_effect", REXCVAR_GET(gow2_antialiasing) == 0 ? "fxaa" : "none");
+  // v00.02: the SDK's read cache by exact range (host_path_file.cpp, from the NFS port) keeps only reads of 256 KB or
+  // more; Gears of War 2 streams its textures from Textures.tfc in 128 KB blocks and read 40-99 % of them again
+  // (v00.01's [io] rangos lines: up to 160 of 201 reads in 15 s were re-reads, 13-50 ms each from the disk).
+  SetDefault("nfsmw_io_rangos_min_kb", "128");
+  SetDefault("nfsmw_io_rangos_mb", "128");
+  // v00.05: the guest's vblanks at the display's (the SDK's graphics_system.cpp): with gow2_vsync's flips at the
+  // vblank, a 30 fps frame then shows for exactly two refreshes instead of drifting against the TV's 59.94 Hz.
+  SetDefault("vblank_from_display", "true");
+}
+
+void LogSystem() {
+  const unsigned mhz = ps4_kit_cpu_mhz();
+  REXLOG_INFO("gow2-ps4 {} (commit {}); the CPU cores run at {} MHz ({})", GOW2_VERSION, GOW2_COMMIT, mhz,
+              gow2::menu::ConsoleText());
+  // The GPU driver reads these when the SDK creates its Vulkan instance and device, which comes after this (and after
+  // gow2.toml is read).
+  const std::string radv_debug = REXCVAR_GET(gow2_radv_debug);
+  if (!radv_debug.empty()) setenv("RADV_DEBUG", radv_debug.c_str(), 1);
+  if (REXCVAR_GET(gow2_gpu_trace)) setenv("RADV_PS4_TRACE", "1", 1);
+  // v00.02: RADV's disk cache (WinePS4 and Wisp set the same variable).
+  std::string shader_cache = "off";
+  if (REXCVAR_GET(gow2_gpu_shader_cache)) {
+    const std::string dir = std::string(ps4_diag_data_dir()) + "/cache/mesa";
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    if (!ec || std::filesystem::is_directory(dir, ec)) {
+      setenv("MESA_SHADER_CACHE_DIR", dir.c_str(), 0);
+      shader_cache = dir;
+    } else {
+      shader_cache = "off (could not make " + dir + ")";
+    }
+  }
+  REXLOG_INFO("[gpu] driver options: RADV_DEBUG={}; flight recorder {}; shader cache {}",
+              radv_debug.empty() ? "(none)" : radv_debug,
+              REXCVAR_GET(gow2_gpu_trace) ? "on (/data/Crema/gpu/flight)" : "off", shader_cache);
+}
+
+void Install(rex::Runtime& runtime) {
+  g_memory = runtime.memory();
+  ppc_msr_cerrojo_global_() = REXCVAR_GET(gow2_msr_global_lock);
+  REXLOG_INFO("[cpu] interrupts-off regions: {}",
+              ppc_msr_cerrojo_global_() ? "one process-wide mutex (codegen)" : "per-thread state");
+  REXLOG_INFO("[gpu] anti-aliasing: {}; occlusion queries {}",
+              REXCVAR_GET(gow2_antialiasing) == 2   ? "the original MSAA (predicated tiles: every draw per tile)"
+              : REXCVAR_GET(gow2_antialiasing) == 1 ? "none (the scene in one pass)"
+                                                    : "FXAA (the scene in one pass)",
+              REXCVAR_GET(gow2_occlusion_queries) ? "on (waits for the GPU)" : "off (reported visible)");
+  rex::kernel::xboxkrnl::SetGuestSwapHook(&OnGuestSwap);
+  ApplyVsync();  // before the first frame (the logos tore too)
+  StartFreezeReport();
+  // The game's achievements: the menu's tab and pop-ups; its own "Achievements" item opens that tab.
+  gow2::achievements::Install(runtime);
+  rex::kernel::xam::SetShowAchievementsUiHook(&gow2::menu::ShowAchievementsList);
+}
+
+unsigned SwapCount() {
+  return g_swaps.load(std::memory_order_acquire);
+}
+
+}  // namespace gow2::ps4
