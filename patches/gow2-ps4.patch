diff --git a/ps4/gow2_ps4_native.cpp b/ps4/gow2_ps4_native.cpp
new file mode 100644
index 0000000..a1a0a58
--- /dev/null
+++ b/ps4/gow2_ps4_native.cpp
@@ -0,0 +1,288 @@
+// gow2-ps4 - native versions of the game's hottest small functions (v00.04).
+//
+// From gears2-nx's gow2/src/gow2_perf_hooks.cpp (VasilkovND, GPL-3.0), which found and checked them on the Switch for
+// this same executable (retail 0.0.0.5 / 0.0.0.6 share their code), rewritten for the PS4's x86 and this SDK's guest
+// address rule (REX_RAW_ADDR: base + address, and 0x1000 more from 0xE0000000 up, as the generated code reads it).
+// Each replaces a recompiled function with the same work in host code; the recompiled one stays callable and takes
+// over whenever an argument is unusual (a range across 0xE0000000, a block the native decoder cannot decode exactly).
+// In the v00.02 profile of a heavy fight these were 8-10 % of the game thread and ~3 % of the render thread.
+//
+//   sub_82A92B70  the C runtime's memcpy (r3 destination, r4 source, r5 bytes; answers r3)
+//   sub_82A93150  the C runtime's memset (r3 destination, r4 byte, r5 bytes)
+//   sub_823ACD10  Unreal's TMap find by a two-word key (an FName); the index or -1 stored at r3
+//   sub_822C1428  a bone's quaternion, translation and scale to a 4x4 matrix (single-precision steps, no fused
+//                 multiply-adds: the Jaguar has none, and the file builds with -ffp-contract=off)
+//   sub_82AB1C28  XMemDecompress: Unreal's 128 KB LZX blocks (packages, streamed textures) through the SDK's libmspack
+//   sub_82982BA0  v00.05: the D3D runtime's vertex shader constant setter (copy into the device's shadow + dirty bits)
+//   sub_82982C80  v00.05: the same for the pixel shader
+//
+// gow2_native_code = false: every one of them runs the recompiled code (to compare).
+
+#include "gow2_pch.h"
+#include "gow2_init.h"
+
+#include <algorithm>
+#include <atomic>
+#include <bit>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+extern "C" {
+#include <mspack.h>
+#include <lzx.h>
+}
+
+REXCVAR_DEFINE_BOOL(gow2_native_code, true, "Gow2",
+                    "Native versions of the game's hottest small functions (memcpy, memset, Unreal's name lookups, "
+                    "bone matrices, LZX decompression) instead of the recompiled ones. Live");
+
+namespace {
+
+// [a, a + n) on one side of 0xE0000000 (the host mapping has a 0x1000 step there) and inside the 4 GB guest space.
+inline bool OneSide(uint32_t a, uint32_t n) {
+  const uint64_t end = uint64_t(a) + n;
+  if (n == 0) return true;
+  if (end > 0x100000000ull) return false;
+  return (a >= 0xE0000000u) == (uint32_t(end - 1) >= 0xE0000000u);
+}
+
+inline uint32_t Load32(uint8_t* base, uint32_t a) {
+  uint32_t v;
+  std::memcpy(&v, REX_RAW_ADDR(a), 4);
+  return __builtin_bswap32(v);
+}
+
+inline void Store32(uint8_t* base, uint32_t a, uint32_t v) {
+  v = __builtin_bswap32(v);
+  std::memcpy(REX_RAW_ADDR(a), &v, 4);
+}
+
+inline float LoadF(uint8_t* base, uint32_t a) { return std::bit_cast<float>(Load32(base, a)); }
+inline void StoreF(uint8_t* base, uint32_t a, float v) { Store32(base, a, std::bit_cast<uint32_t>(v)); }
+
+// --- LZX (XMemCompress blocks: window 2^17, frames prefixed FF + u16 uncompressed + u16 compressed, or a bare u16
+//     compressed size for a full 32 KB frame) ---
+struct LzxSource {
+  const uint8_t* data;
+  size_t size, pos, left;  // left: bytes of the current frame
+};
+struct LzxDest {
+  uint8_t* data;
+  size_t size, pos;
+};
+int LzxRead(mspack_file* file, void* buffer, int bytes) {
+  auto* f = reinterpret_cast<LzxSource*>(file);
+  if (f->left == 0) {
+    if (f->pos >= f->size) return 0;
+    if (f->data[f->pos] == 0xFF) {
+      if (f->pos + 5 > f->size) return 0;
+      f->left = size_t(f->data[f->pos + 3]) << 8 | f->data[f->pos + 4];
+      f->pos += 5;
+    } else {
+      if (f->pos + 2 > f->size) return 0;
+      f->left = size_t(f->data[f->pos]) << 8 | f->data[f->pos + 1];
+      f->pos += 2;
+    }
+    if (f->left > f->size - f->pos) f->left = f->size - f->pos;
+    if (f->left == 0) return 0;
+  }
+  const size_t n = std::min(size_t(bytes), f->left);
+  std::memcpy(buffer, f->data + f->pos, n);
+  f->pos += n;
+  f->left -= n;
+  return int(n);
+}
+int LzxWrite(mspack_file* file, void* buffer, int bytes) {
+  auto* f = reinterpret_cast<LzxDest*>(file);
+  const size_t n = std::min(size_t(bytes), f->size - f->pos);
+  std::memcpy(f->data + f->pos, buffer, n);
+  f->pos += n;
+  return int(n);
+}
+void* LzxAlloc(mspack_system*, size_t bytes) { return std::calloc(bytes, 1); }
+void LzxFree(void* p) { std::free(p); }
+void LzxCopy(void* src, void* dst, size_t bytes) { std::memmove(dst, src, bytes); }
+void LzxMessage(mspack_file*, const char*, ...) {}
+
+bool LzxDecompress(const uint8_t* src, size_t src_size, uint8_t* dst, size_t dst_size) {
+  if (!src_size || !dst_size) return false;
+  mspack_system sys{};
+  sys.read = LzxRead;
+  sys.write = LzxWrite;
+  sys.alloc = LzxAlloc;
+  sys.free = LzxFree;
+  sys.copy = LzxCopy;
+  sys.message = LzxMessage;
+  LzxSource in{src, src_size, 0, 0};
+  LzxDest out{dst, dst_size, 0};
+  lzxd_stream* lzx = lzxd_init(&sys, reinterpret_cast<mspack_file*>(&in), reinterpret_cast<mspack_file*>(&out), 17, 0,
+                               0x8000, off_t(dst_size), 0);
+  if (!lzx) return false;
+  const int r = lzxd_decompress(lzx, off_t(dst_size));
+  lzxd_free(lzx);
+  return r == MSPACK_ERR_OK && out.pos == dst_size;
+}
+
+std::atomic<uint64_t> g_lzx_native{0}, g_lzx_recompiled{0};
+
+}  // namespace
+
+// memcpy(dst r3, src r4, n r5) -> r3 (unchanged)
+REX_EXTERN(sub_82A92B70) {
+  const uint32_t d = ctx.r3.u32, s = ctx.r4.u32, n = ctx.r5.u32;
+  if (!REXCVAR_GET(gow2_native_code) || !OneSide(d, n) || !OneSide(s, n)) {
+    __imp__sub_82A92B70(ctx, base);
+    return;
+  }
+  if (n) std::memmove(REX_RAW_ADDR(d), REX_RAW_ADDR(s), n);
+}
+
+// memset(dst r3, byte r4, n r5) -> r3 (unchanged)
+REX_EXTERN(sub_82A93150) {
+  const uint32_t d = ctx.r3.u32, n = ctx.r5.u32;
+  if (!REXCVAR_GET(gow2_native_code) || !OneSide(d, n)) {
+    __imp__sub_82A93150(ctx, base);
+    return;
+  }
+  if (n) std::memset(REX_RAW_ADDR(d), int(ctx.r4.u32 & 0xFF), n);
+}
+
+// TMap<FName, ...>::Find: r3 = where the index goes, r4 = the map, r5 = the key (two words). The map: elements at +0
+// (20-byte entries: key +0/+4, next index +12), the hash array at +52 (or inline at +48 when null), its size at +56.
+REX_EXTERN(sub_823ACD10) {
+  if (!REXCVAR_GET(gow2_native_code)) {
+    __imp__sub_823ACD10(ctx, base);
+    return;
+  }
+  const uint32_t map = ctx.r4.u32, key = ctx.r5.u32;
+  uint32_t found = 0xFFFFFFFFu;
